local function getTimeout(str)
    if (str:match("Please try again in (%d+%.?%d*)ms") == nil) then
        return (str:match("Please try again in (%d+%.?%d*)s"))
    else
        return (str:match("Please try again in (%d+%.?%d*)ms") * 0.001)
    end
end

local timeoutVal = nil --temp value
function AubUtilLLM_ProcessOutPrompt(tableIn) --processes the out prompt of the llm into errors or formatted outputs, to then be used more as string
    if (tableIn["error"] != nil) then
        local timeoutVal = getTimeout(tableIn["error"]["message"])
        if (timeoutVal != nil) then
            AUBUTIL_LLMCOOLDOWN = (CurTime() + 0.1 + getTimeout(tableIn["error"]["message"]))
        end
        return("error: "..tableIn["error"]["type"].." "..tableIn["error"]["message"])
    end
    if (tableIn["choices"] == nil) then
        return("error no choices for Aub Utility LLM prompt out")
    end
    return(tableIn["choices"][1]["message"]["content"])
end

function numsInStringToInt(stringIn)
    stringIn = stringIn:gsub("%d+%.?%d*", function(match)
        return math.floor(tonumber(match))
    end)
    return(stringIn)
end

local llmtemp = nil --temp value
function AubUtilLLM_SendPrompt(debugName,prompt,functionOut)
    AubUtilLLM_SendPrompt(debugName,prompt,functionOut,0.5,64,nil)
end
function AubUtilLLM_SendPrompt(debugName,prompt,functionOut,heat)
    AubUtilLLM_SendPrompt(debugName,prompt,functionOut,heat,64,nil)
end
function AubUtilLLM_SendPrompt(debugName,prompt,functionOut,heat,maxTokens,entInclude)
    if (CLIENT) then return end --must be ran on server, server-side only function
    if (AUBUTIL_LLMKEY == "" || AUBUTIL_LLMKEY == nil || AUBUTIL_LLMKEY == " ") then --must have key be set
        print([[-= Aub Utility LLM Groq API key (]]..AUBUTIL_LLMKEY..[[) unable to process,
                visit (https://console.groq.com/keys) to get your Groq key,
                it is seemingly fully free and has less limits than Chat GPT,
                hence why this uses Groq. =-]])
        print([[-= Use the console command of "aubutil_llm_setkey KEY" with your key, while admin,
        to set your key for the Aub Utility addon's LLM features to function =-]])
        return
    end
    if (AUBUTIL_LLMCOOLDOWN <= CurTime()) then
        HTTP( {
            failed = function(reason)
                print("Aub Utility LLM HTTP post failed, try running the version of gmod that is good with HTTP stuff if you are not already.", reason)
            end,
            success = function(code, body, headers)
                if (functionOut != nil) then
                    llmtemp = AubUtilLLM_ProcessOutPrompt(util.JSONToTable(body)) --non-error (usually) out
                    if (AUBUTIL_LLMCOOLDOWN > CurTime()) then
                        print("Aub Utility LLM api cannot post, as cooldown is active for "..(AUBUTIL_LLMCOOLDOWN - CurTime()).." seconds.")
                    else --the output area that runs the function with the out prompt.
                        llmtemp = llmtemp:gsub('"', '') --simply remove quotes from output

                        --sapAiNetOpinionChange(llmtemp:match("%(([^)]+)%)"),sapEntity)
                        --llmtemp = sapProcessPromptExtras(llmtemp:gsub("%b()", ""),sapEntity)
                        --print("to say : "..tosayTemp)
                        if (entInclude == nil) then
                            functionOut(llmtemp)
                        else
                            functionOut(llmtemp,entInclude)
                        end
                    end
                else
                    print("Aub Utility LLM api got, but function to output via is nil?")
                end
            end,
            method = "POST",
            headers = {
                ["Authorization"] = "Bearer " .. AUBUTIL_LLMKEY,
                ["Content-Type"] = "application/json"
            },
            body = numsInStringToInt(util.TableToJSON({
                ["model"] = AUBUTIL_LLMMODEL,
                ["messages"] = {{
                    ["role"] = "system",
                    ["content"] = prompt
                }},
                ["max_tokens"] = maxTokens,
                ["temperature"] = heat
            })),
            url = "https://api.groq.com/openai/v1/chat/completions"
        })
    else
        print("Aub Utility LLM api cannot send prompt, due to cooldown active of "..(AUBUTIL_LLMCOOLDOWN - CurTime()).." seconds.")
    end
end

